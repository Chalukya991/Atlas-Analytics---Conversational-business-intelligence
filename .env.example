# ---------------------------------------------------------------------------
# Atlas Analytics — server configuration (copy to server/.env)
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Infrastructure
DATABASE_URL=postgresql://user:password@localhost:5432/ai_ba
# DATABASE_SSL=true            # enable for managed Postgres
REDIS_URL=redis://localhost:6379

# LLM — Ollama (default)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
QWEN_MODEL=qwen3:8b
# LLM_API_KEY=                 # sent as a Bearer token when your Ollama is behind a proxy
LLM_TIMEOUT_MS=120000
LLM_NUM_CTX=8192
PLAN_ATTEMPTS=3

# LLM — OpenAI-compatible alternative (vLLM, LM Studio, Together, OpenAI …)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.example.com/v1
# LLM_MODEL=your-model
# LLM_API_KEY=sk-...

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=replace-with-a-64-char-random-hex-string
TOKEN_TTL=12h

# Storage & engine
STORAGE_PATH=./storage
PYTHON_BIN=python
PYTHON_ENGINE_PATH=../python_engine
ENGINE_TIMEOUT_MS=180000
MAX_FILE_SIZE=104857600
MAX_ROWS=1000000
MAX_FILES_PER_ANALYSIS=20

# HTTP
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
RUN_WORKERS=true              # false in production: run `npm run worker` separately
ANALYSIS_CONCURRENCY=2
LOG_LEVEL=info
